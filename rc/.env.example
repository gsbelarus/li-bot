# PORT
# HTTP port used by the remote controller API server.
# ccs and any reverse proxy must call the controller on this port.
# Change this only if 3100 conflicts with another service on the host.
PORT=3100

# REMOTE_CONTROLLER_SECRET_KEY
# Shared secret required by ccs when calling the remote controller.
# This is the main authentication guard for the rc HTTP API.
# Use a long, random value and keep it synchronized with the value configured in ccs.
# Do not commit the real secret to source control.
REMOTE_CONTROLLER_SECRET_KEY=replace-with-a-strong-shared-secret

# REMOTE_CONTROLLER_MAX_RETAINED_TASKS
# Maximum number of task records rc keeps in memory before older finished tasks are pruned.
# This affects status/result history available directly from the controller API.
# Increase if operators need longer in-memory history between result pulls.
# Decrease if the controller runs with tight memory limits.
REMOTE_CONTROLLER_MAX_RETAINED_TASKS=200

# REMOTE_CONTROLLER_FINISHED_TASK_TTL_MS
# How long, in milliseconds, finished task records remain in memory before automatic cleanup.
# 21600000 ms = 6 hours.
# Increase if ccs may poll results late or operators need a larger recovery window.
REMOTE_CONTROLLER_FINISHED_TASK_TTL_MS=21600000

# REMOTE_CONTROLLER_TASK_CLEANUP_INTERVAL_MS
# How often, in milliseconds, rc scans task history and removes expired finished tasks.
# 300000 ms = 5 minutes.
# Lower values clean up stale records sooner; higher values reduce cleanup frequency.
REMOTE_CONTROLLER_TASK_CLEANUP_INTERVAL_MS=300000

# REMOTE_CONTROLLER_MOUSE_ACTIVITY_ENABLED
# Enables a background OS-level cursor drift loop while a task is executing.
# This is intended for the Windows machine that hosts the browser session.
# Leave disabled on headless hosts or anywhere local pointer movement would be disruptive.
REMOTE_CONTROLLER_MOUSE_ACTIVITY_ENABLED=false

# REMOTE_CONTROLLER_MOUSE_ACTIVITY_MIN_INTERVAL_MS
# Minimum idle time between cursor movement sequences while a task is running.
# Use larger values for rarer movement and smaller values for more frequent drift.
REMOTE_CONTROLLER_MOUSE_ACTIVITY_MIN_INTERVAL_MS=9000

# REMOTE_CONTROLLER_MOUSE_ACTIVITY_MAX_INTERVAL_MS
# Maximum idle time between cursor movement sequences while a task is running.
# Keep this greater than or equal to the minimum interval.
REMOTE_CONTROLLER_MOUSE_ACTIVITY_MAX_INTERVAL_MS=22000

# REMOTE_CONTROLLER_MOUSE_ACTIVITY_MAX_OFFSET_PX
# Maximum number of pixels one movement sequence can drift from the current cursor position.
# Smaller values keep motion subtle; larger values make the cursor roam more visibly.
REMOTE_CONTROLLER_MOUSE_ACTIVITY_MAX_OFFSET_PX=48

# OPENAI_API_KEY
# OpenAI API key used only for ai_driven execution mode.
# If this is empty, ai_driven runs still execute but the resolver falls back to deterministic matching.
# This is required if you want live model-based snapshot target selection in rc.
OPENAI_API_KEY=

# OPENAI_PROJECT_KEY
# Optional OpenAI project identifier.
# Set this only if your OpenAI account/workspace uses project-scoped access and billing.
# Leave empty if your API key works without a project value.
OPENAI_PROJECT_KEY=

# OPENCLAW_AI_MODEL
# Model name rc uses for ai_driven snapshot-ref selection.
# The model is not given arbitrary browser control; it only chooses among bounded candidates.
# Keep this aligned with a fast, instruction-following model suitable for repeated resolver calls.
OPENCLAW_AI_MODEL=gpt-4.1-mini

# OPENCLAW_AI_CANDIDATE_LIMIT
# Maximum number of candidate snapshot refs rc will send to the model for one resolution attempt.
# Higher values may improve recall on dense pages but increase token usage and latency.
# Lower values are cheaper and faster but may omit the correct candidate on cluttered pages.
OPENCLAW_AI_CANDIDATE_LIMIT=24

# OPENCLAW_AI_SNAPSHOT_EXCERPT_CHARS
# Maximum number of snapshot text characters included as page context in one AI resolution request.
# Higher values give the model more surrounding context but increase token usage.
# Lower values reduce cost and latency but may weaken disambiguation on complex pages.
OPENCLAW_AI_SNAPSHOT_EXCERPT_CHARS=2500

# OPENCLAW_BROWSER_PROFILE
# Browser profile name passed to the OpenClaw CLI when rc launches or attaches to browser actions.
# Use the profile that matches the browser session/environment where automation should run.
# The default "chrome" is appropriate for standard Chrome-based usage unless your host setup differs.
OPENCLAW_BROWSER_PROFILE=chrome

# OPENCLAW_GATEWAY_URL
# Optional OpenClaw gateway base URL.
# Set this when OpenClaw commands should be routed through a remote/local gateway instead of default CLI behavior.
# Leave empty if rc should use the local OpenClaw setup directly.
OPENCLAW_GATEWAY_URL=

# OPENCLAW_GATEWAY_TOKEN
# Optional authentication token for the OpenClaw gateway.
# Required only when the configured gateway enforces token-based access.
# Leave empty if no gateway is used or the gateway does not require a token.
OPENCLAW_GATEWAY_TOKEN=

# OPENCLAW_BIN
# Executable name or absolute path for the OpenClaw CLI binary rc should invoke.
# Change this if OpenClaw is not on PATH or if the host uses a custom install location.
# On Windows, this can be a full path to the executable if needed.
OPENCLAW_BIN=openclaw